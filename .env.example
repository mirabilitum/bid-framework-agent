# 标书框架生成工具 - API 配置文件
# 将此文件复制为 .env，填入你的配置，放到 exe 同目录下即可自动读取
# 程序启动时若检测到 .env，将跳过交互式询问直接使用以下配置

# LLM 提供商（可选：deepseek / doubao / qwen / claude / openai）
LLM_PROVIDER=doubao

# API Key
LLM_API_KEY=

# 模型名称（留空使用默认）
# DeepSeek 默认: deepseek-chat
# 豆包 默认: doubao-pro-128k
# 通义千问 默认: qwen-max
# Claude 默认: claude-sonnet-4-20250514
# OpenAI 默认: gpt-4o
LLM_MODEL=doubao-seed-2-0-pro

# 自定义 API 地址（使用官方接口可留空）
# DeepSeek: https://api.deepseek.com/v1
# 豆包: https://ark.cn-beijing.volces.com/api/v3
# 国内 Claude 代理等: 填入对应地址
LLM_BASE_URL=https://llm-gw.shangruitong.com/v1
